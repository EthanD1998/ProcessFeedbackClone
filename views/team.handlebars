<section class="team-page">

    <div class="team-header">
        <h1>Process Feedback's Team</h1>
        <p>
            Designers, developers, testers, and supporters who brought Process Feedback to life and keep it vital
        </p>
    </div>

    <h2 class="team-subtitle">Active contributors</h2>

    <div class="team-grid">
        {{#each teamMembers}}
        <div class="{{this.cardClass}}">
            <div class="team-name">{{this.name}}</div>
            <div class="team-role">{{this.role}}</div>
        </div>
        {{/each}}
    </div>

</section>