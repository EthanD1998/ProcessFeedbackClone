<section class="contact-hero">
    <div class="contact-hero-inner">
        <h1>Contact Us</h1>
        <p>Reach out to us with your questions or feedback</p>
    </div>
</section>

<section class="contact-email-section">
    <div class="contact-email-inner">
        <div class="contact-email-text">
            <h1>Send us an email</h1>
            <p>
                We can be reached at
                <a href="mailto:contact@processfeedback.org" id="contact-email">
                    contact@processfeedback.org
                </a>,
                which is our preferred method of communication. Please email us directly with your email account.
            </p>
            <button id="copy-email-btn" class="copy-email-btn" type="button">
                Copy Email Address
            </button>
        </div>

        <div class="contact-email-image">
            <img src="/css/images/email.png" alt="Email illustration">
        </div>
    </div>
</section>

<section class="contact-page">
    <div class="contact-header">
        <h1>Send us a message</h1>
        <p>
            Use this form below to send us a message. Please double check your email
            address before submitting the form because that is where we will reply.
            Also, sometimes our reply to you could land in your spam folder.
        </p>
    </div>

    <div class="contact-card">
        <div class="contact-illustration">
            <img src="/css/images/contact-illustration.png" alt="Contact illustration">
        </div>

        <div class="contact-form-side">
            {{#if success}}
            <p class="success-msg">{{success}}</p>
            {{/if}}

            {{#if error}}
            <p class="error-msg">{{error}}</p>
            {{/if}}

        <form action="/contact" method="POST" class="contact-form">

            <input type="text" name="honeypot" class="honeypot-field" autocomplete="off">

            <div class="contact-row">
                <label for="name">Your name <span>*</span></label>
                <input id="name" name="name" type="text" placeholder="John Doe" required>
            </div>

            <div class="contact-row">
                <label for="email">Your email <span>*</span></label>
                <input id="email" name="email" type="email" placeholder="you@university.edu" required>
            </div>

            <div class="contact-row">
                <label for="confirmEmail">Retype email <span>*</span></label>
                <input id="confirmEmail" name="confirmEmail" type="email" placeholder="you@university.edu" required>
            </div>

            <div class="contact-row">
                <label for="subject">Subject <span>*</span></label>
                <input id="subject" name="subject" type="text" placeholder="Topic of your message" required>
            </div>

            <div class="contact-row contact-row-message">
                <label for="message">Message <span>*</span></label>
                <textarea id="message" name="message" placeholder="Share us your question or feedback" required></textarea>
            </div>

            <div class="contact-button-wrap">
                <button type="submit">Send Message </button>
            </div>
        </form>
        </div>
    </div>
</section>

<section class="meeting-section">
    <div class="meeting-inner">
        <h1>Schedule a meeting with the founder</h1>

        <div class="meeting-content">
            <div class="meeting-text">
                <p>
                    If you'd like to ask a question or share your thoughts with
                    the founder of the project,
                    <a href="#">Dr. Badri Adhikari</a>, you're welcome to schedule a meeting with him.
                </p>

                <a href="#" class="meeting-btn">Schedule a Meeting</a>
            </div>

            <div class="meeting-image">
                <img src="/css/images/calendar.jpg" alt="Calendar illustration">
            </div>
        </div>
    </div>
</section>

<section class="careers-section">
    <div class="careers-inner">

        <div class="careers-image">
            <img src="/css/images/careers.png" alt="Careers illustration">
        </div>

        <div class="careers-text">
            <h2>Careers at Process Feedback</h2>

            <p>
                We are always looking for volunteers and students who are passionate about solving meaningful problems.
            </p>

            <p>
                If you're interested in contributing, please email us with the subject line
                <strong>Interested to contribute to Process Feedback</strong>.
                Be sure to include at least one idea for how you think Process Feedback could be improved.
            </p>

        </div>

    </div>
</section>

<section class="updates-section">
    <div class="updates-inner">
        <div class="updates-image">
            <img src="/css/images/updates.png" alt="Social media updates illustration">
        </div>

        <div class="updates-text">
            <h2>Don't miss our updates</h2>
            <p>
                Follow us on social media to stay updated on new features and improvements
                happening at Process Feedback.
            </p>

            <div class="social-icons">
                <a href="#" aria-label="Facebook">f</a>
                <a href="#" aria-label="X">X</a>
                <a href="#" aria-label="LinkedIn">in</a>
                <a href="#" aria-label="YouTube">▶</a>
            </div>
        </div>
    </div>
</section>

<script src="/js/contact.js"></script>