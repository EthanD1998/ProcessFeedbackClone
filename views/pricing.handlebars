<!-- insitution -->
<section class="institution-section reveal">
  <div class="institution-container">

    <h2 class="institution-title">What institutional pricing covers</h2>

    <p class="institution-description">
      Most individual use runs directly in the browser and has minimal infrastructure cost. Institutional
      deployments are different. They often require formal support, compliance documentation, governed data
      handling, and broader deployment planning. Institutional pricing reflects the deployment scope, the level
      of data handling required, and the support expected.
    </p>

    <div class="institution-content">

      <!-- Image -->
      <div class="institution-image">
        <img src="/css/images/shield.png" alt="Security">
      </div>

      <!-- Text -->
      <div class="institution-text">
        <p class="institution-subtitle">
          Institutions do not pay based on the number of students or teachers. Institutional pricing covers:
        </p>

        <ul class="institution-list">
          <li>Formal deployment support</li>
          <li>LMS or LTI integration where required</li>
          <li>Privacy, security, and compliance documentation</li>
          <li>Institutional agreements covering data handling and retention</li>
          <li>Priority support, onboarding, and training</li>
          <li>Specialized hosting or jurisdiction-specific requirements when needed</li>
        </ul>
      </div>
    </div>

    <div class="institution-btn-wrapper">
      <a href="/not-found" class="institution-btn">See Institutional Pricing</a>
    </div>

  </div>
</section>

